
import RPi.GPIO as GPIO
from time import sleep

GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)

CLK = 17
DT = 27
SW = 22
PIR = 20
LED = 18

GPIO.setup(CLK, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(DT, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(SW, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(PIR, GPIO.IN)
GPIO.setup(LED, GPIO.OUT)

# Set up PWM for LED brightness
led_pwm = GPIO.PWM(LED, 100)
led_pwm.start(0)

clk_prev = GPIO.input(CLK)
sw_prev = GPIO.input(SW)
encode_count = 0

try:
    while True:
        clk_status = GPIO.input(CLK)
        dt_status = GPIO.input(DT)
        sw_status = GPIO.input(SW)
        motion = GPIO.input(PIR)

        # Rotary encoder controls brightness
        if clk_prev == 1 and clk_status == 0:
            if clk_status == dt_status:
                encode_count += 1
            else:
                encode_count -= 1

            # Limit count between 0 and 20
            encode_count = max(0, min(20, encode_count))
            print("Encoder count =", encode_count)

        clk_prev = clk_status

        # Reset encoder count when button pressed
        if sw_prev == 1 and sw_status == 0:
            encode_count = 0
            print("Encoder reset to 0")

        sw_prev = sw_status

        # Each pulse increases brightness by 5%
        brightness = encode_count * 5

        # PIR detects motion: LED turns OFF
        if motion == 1:
            brightness = 0

        # Update LED brightness
        led_pwm.ChangeDutyCycle(brightness)

        sleep(0.001)

except KeyboardInterrupt:
    print("Program stopped")

finally:
    led_pwm.stop()
    GPIO.cleanup()
