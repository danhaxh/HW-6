
import RPi.GPIO as GPIO
from time import sleep

GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)

# Set GPIO pins
CLK = 17
DT = 27
PIR = 20
LED = 18

# Set up inputs and output
GPIO.setup(CLK, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(DT, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(PIR, GPIO.IN)
GPIO.setup(LED, GPIO.OUT)

# Set PWM frequency to 100 Hz
pwm = GPIO.PWM(LED, 100)
pwm.start(0)

count = 0
old_clk = GPIO.input(CLK)
old_motion = GPIO.input(PIR)

while True:

    clk = GPIO.input(CLK)
    motion = GPIO.input(PIR)

    # Check rotary encoder
    if old_clk == 1 and clk == 0:

        if GPIO.input(DT) == 1:
            count = count + 1
        else:
            count = count - 1

        # Limit count from 0 to 10
        if count < 0:
            count = 0

        if count > 10:
            count = 10

        print("Encoder Count:", count)
        sleep(0.01)

    old_clk = clk

    # Check PIR sensor
    if motion == 1:
        pwm.ChangeDutyCycle(0)

        if old_motion == 0:
            print("Motion Detected - LED OFF")

    else:
        duty = count * 10
        pwm.ChangeDutyCycle(duty)

        if old_motion == 1:
            print("No Motion - LED ON")

    old_motion = motion

    sleep(0.001)
